{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "default_agent": "plan",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high"
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-terra": {
          "options": {
            "reasoningSummary": "auto"
          }
        }
      }
    }
  },
  "permission": "allow",
  "plugin": [
    "oh-my-opencode-slim",
    "@boopdoopgoop/opencode-btw"
  ],
  "lsp": true
}
