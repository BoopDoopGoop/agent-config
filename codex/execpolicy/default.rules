prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Destructive git reset should require explicit user intent",
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "Destructive workspace cleanup should require explicit user intent",
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force pushes are destructive",
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Force pushes are destructive",
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Recursive deletion is destructive",
)
