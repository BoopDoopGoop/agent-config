prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Destructive git reset should require explicit user intent",
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "Destructive workspace cleanup should require explicit user intent",
)

prefix_rule(
    pattern = ["git", "restore"],
    decision = "forbidden",
    justification = "Restoring files can discard uncommitted work",
)

prefix_rule(
    pattern = ["git", "checkout", "--"],
    decision = "forbidden",
    justification = "Checking out paths can discard uncommitted work",
)

prefix_rule(
    pattern = ["git", "stash", ["drop", "clear"]],
    decision = "forbidden",
    justification = "Deleting stashes can permanently discard uncommitted work",
)

prefix_rule(
    pattern = ["git", "reflog", "expire"],
    decision = "forbidden",
    justification = "Expiring reflogs can remove the recovery path for Git history",
)

prefix_rule(
    pattern = ["git", "gc", ["--prune", "--prune=now", "--aggressive"]],
    decision = "forbidden",
    justification = "Aggressive Git garbage collection can permanently remove recoverable objects",
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force pushes are destructive",
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Force pushes are destructive",
)

prefix_rule(
    pattern = ["git", "push", "--force-with-lease"],
    decision = "forbidden",
    justification = "Force pushes are destructive",
)

prefix_rule(
    pattern = ["git", "push", "--force-if-includes"],
    decision = "forbidden",
    justification = "Force pushes are destructive",
)

prefix_rule(
    pattern = ["git", "push", "origin", "--force"],
    decision = "forbidden",
    justification = "Force pushes are destructive",
)

prefix_rule(
    pattern = ["git", "push", "origin", "-f"],
    decision = "forbidden",
    justification = "Force pushes are destructive",
)

prefix_rule(
    pattern = ["git", "push", "origin", "--force-with-lease"],
    decision = "forbidden",
    justification = "Force pushes are destructive",
)

prefix_rule(
    pattern = ["git", "push", "origin", "--force-if-includes"],
    decision = "forbidden",
    justification = "Force pushes are destructive",
)

prefix_rule(
    pattern = ["git", "push", "--delete"],
    decision = "forbidden",
    justification = "Deleting remote refs can remove shared recovery points",
)

prefix_rule(
    pattern = ["git", "push", "origin", "--delete"],
    decision = "forbidden",
    justification = "Deleting remote refs can remove shared recovery points",
)

prefix_rule(
    pattern = ["rm", ["-r", "-R", "--recursive"]],
    decision = "forbidden",
    justification = "Recursive deletion is destructive",
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Recursive deletion is destructive",
)

prefix_rule(
    pattern = ["rm", "-fr"],
    decision = "forbidden",
    justification = "Recursive deletion is destructive",
)

prefix_rule(
    pattern = ["rm", "-r", "-f"],
    decision = "forbidden",
    justification = "Recursive deletion is destructive",
)

prefix_rule(
    pattern = ["rm", "-f", "-r"],
    decision = "forbidden",
    justification = "Recursive deletion is destructive",
)

prefix_rule(
    pattern = ["/bin/rm", "-rf"],
    decision = "forbidden",
    justification = "Recursive deletion is destructive",
)

prefix_rule(
    pattern = ["/bin/rm", "-fr"],
    decision = "forbidden",
    justification = "Recursive deletion is destructive",
)

prefix_rule(
    pattern = ["/bin/rm", "-r", "-f"],
    decision = "forbidden",
    justification = "Recursive deletion is destructive",
)

prefix_rule(
    pattern = ["/bin/rm", "-f", "-r"],
    decision = "forbidden",
    justification = "Recursive deletion is destructive",
)

prefix_rule(
    pattern = ["/bin/rm", ["-r", "-R", "--recursive"]],
    decision = "forbidden",
    justification = "Recursive deletion is destructive",
)

prefix_rule(
    pattern = [["srm", "shred", "truncate", "dd"]],
    decision = "forbidden",
    justification = "This command can irreversibly erase or overwrite file contents",
)

prefix_rule(
    pattern = ["xargs", "rm"],
    decision = "forbidden",
    justification = "Bulk deletion through xargs is destructive",
)

prefix_rule(
    pattern = ["/usr/bin/xargs", "rm"],
    decision = "forbidden",
    justification = "Bulk deletion through xargs is destructive",
)

prefix_rule(
    pattern = ["diskutil", ["eraseDisk", "eraseVolume", "partitionDisk", "secureErase"]],
    decision = "forbidden",
    justification = "Disk erasure and repartitioning are destructive",
)

prefix_rule(
    pattern = [["mkfs", "newfs", "newfs_apfs", "newfs_hfs"]],
    decision = "forbidden",
    justification = "Formatting a filesystem irreversibly destroys existing data",
)

prefix_rule(
    pattern = ["terraform", "destroy"],
    decision = "forbidden",
    justification = "Destroying managed infrastructure can permanently delete data",
)

prefix_rule(
    pattern = ["docker", ["system", "volume"], "prune"],
    decision = "forbidden",
    justification = "Pruning Docker system or volume data can permanently delete data",
)
