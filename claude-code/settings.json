{
  "permissions": {
    "deny": [
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -r -f*)",
      "Bash(rm -f -r*)",
      "Bash(/bin/rm -rf*)",
      "Bash(/bin/rm -fr*)",
      "Bash(/bin/rm -r -f*)",
      "Bash(/bin/rm -f -r*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push --force-if-includes*)",
      "Bash(git push * --force-if-includes*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "sandbox": {
    "enabled": true
  },
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoCompactEnabled": true,
  "statusLine": {
    "enabled": true,
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  }
}
