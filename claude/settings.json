{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(rg*)",
      "Bash(grep*)",
      "Bash(find . -type f -print)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git remote*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git checkout -b*)",
      "Bash(git switch -c*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "effortLevel": "medium"
}
